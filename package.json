{
  "name": "ferroscale",
  "version": "3.26.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "prebuild": "node scripts/inject-sw-version.mjs",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint",
    "generate:icons": "node scripts/generate-icons.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:core": "npm run test --workspace @ferroscale/metal-core",
    "test:all": "npm run test && npm run test:core"
  },
  "dependencies": {
    "next": "16.3.4",
    "next-intl": "^4.14.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  }
}
